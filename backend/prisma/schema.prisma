generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ScheduleType {
  FULL_TIME
  PART_TIME
  SHIFT
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  LATE
  ABSENT
  OVERTIME
  MISSING_CHECKOUT
}

enum PasswordResetRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum AllocationStatus {
  PENDING
  ACTIVE
  REFUSED
  EXPIRED
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

enum RuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

enum ComputationMethod {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTING
  COMPUTED
  VALIDATED
  PAID
  SENT
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  SENT
}

model User {
  id                  Int    @id @default(autoincrement())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  roles               Role[]
  employeeId          Int?   @unique @map("employee_id")
  employee            Employee? @relation(fields: [employeeId], references: [id])
  isActive            Boolean   @default(true) @map("is_active")
  // Set whenever an admin sets someone else's password (a direct reset, or by
  // resolving a PasswordResetRequest). The login response carries it and the
  // client is forced to /change-password before anything else — so an admin
  // never holds a lasting working password for another person's account.
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  passwordResetRequests  PasswordResetRequest[] @relation("PasswordResetSubject")
  passwordResetsResolved PasswordResetRequest[] @relation("PasswordResetResolver")

  @@map("users")
}

// A "I forgot my password" ticket raised from the login screen. There's no
// outbound mail path for a self-service reset link in this system, so the
// flow is deliberately human: the request lands in an admin's queue and an
// admin sets a new password out-of-band.
//
// `email` is stored as typed rather than only as a userId, because the row is
// also created (with userId null) for an address that matches no account —
// the endpoint must answer identically either way or it becomes an account
// enumeration oracle.
model PasswordResetRequest {
  id           Int                     @id @default(autoincrement())
  email        String
  userId       Int?                    @map("user_id")
  user         User?                      @relation("PasswordResetSubject", fields: [userId], references: [id], onDelete: SetNull)
  note         String?
  status       PasswordResetRequestStatus @default(PENDING)
  resolvedById Int?                    @map("resolved_by_id")
  resolvedBy   User?                      @relation("PasswordResetResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?                  @map("resolved_at")
  createdAt    DateTime                   @default(now()) @map("created_at")

  @@index([status])
  @@index([userId])
  @@map("password_reset_requests")
}

model RefreshToken {
  id         Int    @id @default(autoincrement())
  userId     Int    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           Int   @id @default(autoincrement())
  actorUserId  Int?  @map("actor_user_id")
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  before       Json?
  after        Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Employee {
  id            Int         @id @default(autoincrement())
  name          String
  department    String
  managerId     Int?        @map("manager_id")
  manager       Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  reports       Employee[]     @relation("EmployeeManager")
  jobPosition   String         @map("job_position")
  scheduleId    Int?        @map("schedule_id")
  schedule      WorkingSchedule? @relation(fields: [scheduleId], references: [id])
  status        EmployeeStatus @default(ACTIVE)
  // Payroll Dashboard's "missing bank account" alert needs a real signal to
  // check, not a guess — this is that signal. No actual bank details are
  // stored anywhere (out of scope), just whether they're on file.
  bankAccountOnFile Boolean    @default(false) @map("bank_account_on_file")
  createdAt     DateTime       @default(now()) @map("created_at")

  user                User?
  contracts           Contract[]
  attendances         Attendance[]
  timeOffAllocations  TimeOffAllocation[]
  timeOffRequests     TimeOffRequest[]
  payslips            Payslip[]

  @@index([department])
  @@index([status])
  @@map("employees")
}

model Contract {
  id                Int         @id @default(autoincrement())
  employeeId        Int         @map("employee_id")
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date") @db.Date
  // Annual Cost to Company — what HR actually knows and negotiates, not a
  // monthly figure someone has to pre-derive by hand. The rule engine divides
  // this by 12 (and prorates by attendance) to seed the WAGE a structure's
  // rules build Basic/HRA/allowances down from; see ruleEngine.js.
  ctc               Decimal        @db.Decimal(12, 2)
  // The employee's nominal/default structure — NOT what computePayrun reads.
  // A Payrun applies its own salaryStructureId uniformly to every selected
  // employee; this column is instead consulted by payrunValidation's
  // structure_mismatch check, which flags when a Payrun computed an employee
  // against a different structure than their contract nominally specifies.
  salaryStructureId Int?        @map("salary_structure_id")
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  status            ContractStatus @default(DRAFT)
  createdAt         DateTime       @default(now()) @map("created_at")

  payslips Payslip[]

  @@index([employeeId])
  @@index([status])
  @@map("contracts")
}

model WorkingSchedule {
  id          Int       @id @default(autoincrement())
  name        String
  type        ScheduleType
  weeklyHours Decimal      @map("weekly_hours") @db.Decimal(5, 2)
  pattern     Json

  employees Employee[]

  @@map("working_schedules")
}

model Attendance {
  id                Int            @id @default(autoincrement())
  employeeId        Int            @map("employee_id")
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkIn           DateTime          @map("check_in")
  checkOut          DateTime?         @map("check_out")
  workedHours       Decimal?          @map("worked_hours") @db.Decimal(5, 2)
  overtimeHours     Decimal           @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  // How much of a working day this record actually earns: 1 = full, 0.5 =
  // half, 0 = didn't clear the half-day bar (or never checked out). Derived
  // alongside `status` in services/attendance.js and never client-supplied.
  // This — not a count of rows — is what payroll prorates against, so a
  // one-minute check-in can no longer pay a full day.
  dayFraction       Decimal           @default(0) @map("day_fraction") @db.Decimal(3, 2)
  status            AttendanceStatus
  isManualCorrection Boolean          @default(false) @map("is_manual_correction")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([checkIn])
  @@map("attendances")
}

model TimeOffType {
  id                Int      @id @default(autoincrement())
  name              String
  unit              TimeOffUnit
  requiresAllocation Boolean    @default(true) @map("requires_allocation")
  payrollIntegrated Boolean     @default(false) @map("payroll_integrated")
  approverRole      String?     @map("approver_role")
  displayColor      String?     @map("display_color")

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]

  @@map("time_off_types")
}

model TimeOffAllocation {
  id            Int            @id @default(autoincrement())
  employeeId    Int            @map("employee_id")
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffTypeId Int            @map("time_off_type_id")
  timeOffType   TimeOffType       @relation(fields: [timeOffTypeId], references: [id])
  allocated     Decimal           @db.Decimal(6, 2)
  taken         Decimal           @default(0) @db.Decimal(6, 2)
  remaining     Decimal           @db.Decimal(6, 2)
  validFrom     DateTime          @map("valid_from") @db.Date
  validTo       DateTime          @map("valid_to") @db.Date
  status        AllocationStatus  @default(PENDING)

  @@index([employeeId])
  @@map("time_off_allocations")
}

model TimeOffRequest {
  id            Int                @id @default(autoincrement())
  employeeId    Int                @map("employee_id")
  employee      Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffTypeId Int                @map("time_off_type_id")
  timeOffType   TimeOffType           @relation(fields: [timeOffTypeId], references: [id])
  startDate     DateTime              @map("start_date") @db.Date
  endDate       DateTime              @map("end_date") @db.Date
  duration      Decimal               @db.Decimal(6, 2)
  status        TimeOffRequestStatus  @default(PENDING)
  // Which allocation approval actually deducted from. Recorded at approve
  // time so a later cancellation can put the exact same balance back —
  // re-running the "which allocation covers these dates" lookup at cancel
  // time could resolve to a different row if allocations changed in between.
  allocationId  Int?               @map("allocation_id")
  // An employee can't cancel their own APPROVED leave (that would let them
  // hand their own balance back), so instead they raise a request for HR to
  // do it. Kept as fields on the request rather than a separate model: the
  // request stays the single source of truth for its own lifecycle, and the
  // approver queue is a filter on this one flag.
  cancellationRequested   Boolean   @default(false) @map("cancellation_requested")
  cancellationReason      String?   @map("cancellation_reason")
  cancellationRequestedAt DateTime? @map("cancellation_requested_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([status])
  @@index([cancellationRequested])
  @@map("time_off_requests")
}

model SalaryStructure {
  id     Int  @id @default(autoincrement())
  name   String
  active Boolean @default(true)

  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]

  @@map("salary_structures")
}

model SalaryRule {
  id                Int            @id @default(autoincrement())
  salaryStructureId Int            @map("salary_structure_id")
  salaryStructure   SalaryStructure   @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  name              String
  code              String
  category          RuleCategory
  sequence          Int
  computationMethod ComputationMethod @map("computation_method")
  formulaOrValue    String            @map("formula_or_value")

  payslipLines PayslipLine[]

  @@index([salaryStructureId, sequence])
  @@map("salary_rules")
}

model Payrun {
  id                Int          @id @default(autoincrement())
  name              String
  salaryStructureId Int          @map("salary_structure_id")
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  periodStart       DateTime        @map("period_start") @db.Date
  periodEnd         DateTime        @map("period_end") @db.Date
  status            PayrunStatus    @default(DRAFT)
  createdAt         DateTime        @default(now()) @map("created_at")

  payslips Payslip[]

  @@index([status])
  @@map("payruns")
}

model Payslip {
  id          Int        @id @default(autoincrement())
  payrunId    Int        @map("payrun_id")
  payrun      Payrun        @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  // Deliberately denormalized: employeeId is technically derivable via
  // contractId -> Contract.employeeId, but is kept as its own direct column
  // for two reasons the join path can't provide — (1) @@unique([payrunId,
  // employeeId]) below needs both columns to physically exist on this table,
  // it can't be expressed across a join, and (2) every ownership check
  // (an Employee viewing their own payslips) reads this column directly on
  // what is otherwise a very hot read path.
  employeeId  Int        @map("employee_id")
  employee    Employee      @relation(fields: [employeeId], references: [id])
  contractId  Int        @map("contract_id")
  contract    Contract      @relation(fields: [contractId], references: [id])
  status      PayslipStatus @default(DRAFT)
  workedDays  Decimal       @map("worked_days") @db.Decimal(5, 2)
  createdAt   DateTime      @default(now()) @map("created_at")

  lines PayslipLine[]

  @@unique([payrunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

model PayslipLine {
  id           Int     @id @default(autoincrement())
  payslipId    Int     @map("payslip_id")
  payslip      Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRuleId Int     @map("salary_rule_id")
  salaryRule   SalaryRule @relation(fields: [salaryRuleId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)

  @@index([payslipId])
  @@map("payslip_lines")
}
