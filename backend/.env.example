NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://peoplepay:peoplepay@localhost:5433/peoplepay360
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3000

BCRYPT_COST=12
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Pinned so `npm run seed` produces the same demo login for everyone on the
# team instead of a fresh random password every reseed.
SEED_DEMO_PASSWORD=admin@20

COMPANY_NAME=OXP Pvt Ltd
